# ---------------------------------------------------------------- build outputs
dist/
native/target/
extension/node_modules/
extension/build/
extension/build-tests/
installer/build/
*.tsbuildinfo

# ------------------------------------------ downloaded at build time (pinned + SHA-256 verified)
# Model and tokenizer (scripts/fetch-model.ps1)
models/*/
!models/README.md
# ONNX Runtime + VC++ runtime DLLs (scripts/fetch-runtime.ps1)
native/runtime/
*.onnx
*.dll

# ---------------------------------------------------------------- generated test data
# Test PDFs are regenerated byte-for-byte by scripts/make-fixture.mjs
tests/fixtures/*.pdf
tests/fixtures/*.pages.json

# --------------------------------------------- user data that must never be committed
# PDFs anywhere (may be confidential documents); fixtures are generated, see above
*.pdf
# Local index caches and SQLite journals (contain document text)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
# Exported relevance feedback (contains real queries and document excerpts)
legalsearch-evaluation-*.json
legalsearch-feedback*.json
# Logs
*.log
logs/

# ---------------------------------------------------------------- installer temporaries
is-*.tmp/
_unins*.tmp
*.tmp

# ---------------------------------------------------------------- secrets and signing material
.env
.env.*
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
*.spc
*.pvk
*.snk
*.jks
*.keystore
secrets/
# Chrome extension private keys (the repository only keeps the PUBLIC key in config/)
*.crx
extension-private-key*

# ---------------------------------------------------------------- editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
